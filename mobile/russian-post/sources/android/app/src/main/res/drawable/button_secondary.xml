<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#DDEBE7" />
            <stroke
                android:width="1dp"
                android:color="#80ADA4" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#F5FAF8" />
            <stroke
                android:width="1dp"
                android:color="#B7DCD2" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
